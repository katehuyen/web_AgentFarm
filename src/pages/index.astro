---
// agentfarm.space, the landing page. Order agreed with the product owner: the v2.3 relay hero, the v2.2 fleet wall,
// the v2.1 console, then the backlog the work comes from, the relay proof and the remaining scenes of the plan
// (docs/DESIGN.md has the map).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SideIndex from '../components/SideIndex.astro';
import Footer from '../components/Footer.astro';
import S01Relay from '../components/sections/S01Relay.astro';
import S02Fleet from '../components/sections/S02Fleet.astro';
import S03Atlas from '../components/sections/S03Atlas.astro';
import S04Console from '../components/sections/S04Console.astro';
import S05Backlog from '../components/sections/S05Backlog.astro';
import S06Days from '../components/sections/S06Days.astro';
import S07Rules from '../components/sections/S07Rules.astro';
import S08NeverWaits from '../components/sections/S08NeverWaits.astro';
import S09Together from '../components/sections/S09Together.astro';
import S10More from '../components/sections/S10More.astro';
import S11Local from '../components/sections/S11Local.astro';
import S12Close from '../components/sections/S12Close.astro';
---
<Base
  title="Agent Farm · Mission control for AI coding agents in VS Code"
  description="Run Claude Code, Codex, Gemini, Antigravity and OpenCode from one console. Agents work through your project backlog item by item, relay chains run day and night across accounts, and nothing is sent to us."
>
  <Header />
  <SideIndex />
  <main>
    <S01Relay />
    <S02Fleet />
    <S03Atlas />
    <S04Console />
    <S05Backlog />
    <S06Days />
    <S07Rules />
    <S08NeverWaits />
    <S09Together />
    <S10More />
    <S11Local />
    <S12Close />
  </main>
  <Footer />
</Base>
