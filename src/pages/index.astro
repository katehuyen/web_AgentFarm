---
// agentfarm.space, the landing page. Order agreed with the product owner: the v2.3 relay hero, the v2.2 fleet wall,
// the v2.1 console, then the backlog the work comes from, the relay proof and the remaining scenes of the plan
// (docs/DESIGN.md has the map).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SideIndex from '../components/SideIndex.astro';
import Footer from '../components/Footer.astro';
import S01Relay from '../components/sections/S01Relay.astro';
import S02Fleet from '../components/sections/S02Fleet.astro';
import S03Console from '../components/sections/S03Console.astro';
import S04Backlog from '../components/sections/S04Backlog.astro';
import S05Days from '../components/sections/S05Days.astro';
import S06Rules from '../components/sections/S06Rules.astro';
import S07NeverWaits from '../components/sections/S07NeverWaits.astro';
import S08Together from '../components/sections/S08Together.astro';
import S09More from '../components/sections/S09More.astro';
import S10Local from '../components/sections/S10Local.astro';
import S11Close from '../components/sections/S11Close.astro';
---
<Base
  title="Agent Farm · Mission control for AI coding agents in VS Code"
  description="Run Claude Code, Codex, Gemini, Antigravity and OpenCode from one console. Agents work through your project backlog item by item, relay chains run day and night across accounts, and nothing is sent to us."
>
  <Header />
  <SideIndex />
  <main>
    <S01Relay />
    <S02Fleet />
    <S03Console />
    <S04Backlog />
    <S05Days />
    <S06Rules />
    <S07NeverWaits />
    <S08Together />
    <S09More />
    <S10Local />
    <S11Close />
  </main>
  <Footer />
</Base>
