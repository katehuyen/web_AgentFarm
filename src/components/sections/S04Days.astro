---
// 04 · Days (from prototype v2.3): one chain drawn across the days it ran. Seeded simulation of the real relay rules.
import { facts } from '../../data/facts.js';
---
<section id="s-days" class="gap" aria-label="One relay chain across several days">
  <div class="wrap">
    <p class="sx"><b>04</b> Days, not minutes</p>
    <div class="sh">
      <div><p class="pre">chn_7f3a · demo data shaped like the real chain</p><h2 id="d-title">Ninety-two legs. <em>Three nights.</em> One task.</h2></div>
      <p class="lead">Every block is one fresh session. The colour is the account it ran on. A hatched gap is the chain parked until a quota window reset, then waking up by itself. Hover a block to read it.</p>
    </div>
    <div class="strip" id="d-strip"><canvas id="d-canvas" aria-label={`Timeline of ${facts.realChainLegs} relay legs across days`}></canvas><div class="tip" id="d-tip"></div></div>
    <div class="stats">
      <div><b id="d-legs">0</b><span>legs</span></div>
      <div><b id="d-hours">0h</b><span>wall clock</span></div>
      <div><b>4</b><span>accounts</span></div>
      <div><b id="d-parks">0</b><span>parks till reset</span></div>
      <div><b id="d-quota">0</b><span>quota handovers</span></div>
      <div><b id="d-updates">0</b><span>self-updates</span></div>
    </div>
    <div class="legend" id="d-legend"></div>
  </div>
</section>
