    <span class="verchip" title="The version running in the demo below"><i></i><span id="af-ver">3.931.0</span></span>
    <nav class="nav" aria-label="Main">
      <a href="#s-atlas">The farm</a><a href="#ch-relay">Relay</a><a href="#ch-projects">Projects</a><a href="#ch-studio">Studio</a><a href="#ch-memory">Memory</a><a href="#ch-bridge">Just ask</a><a href="#ch-privacy">Local</a>
