      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="2.6"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><line x1="6.5" y1="6.5" x2="10.1" y2="10.1"/><line x1="17.5" y1="6.5" x2="13.9" y2="10.1"/><line x1="6.5" y1="17.5" x2="10.1" y2="13.9"/><line x1="17.5" y1="17.5" x2="13.9" y2="13.9"/></svg>
      Agent Farm
