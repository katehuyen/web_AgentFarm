---
// Fixed section index on the right edge (desktop). Highlights the section that crosses the middle of the screen.
const SECTIONS = [
  ['s-relay', 'Relay'], ['s-fleet', 'Fleet'], ['s-console', 'Console'], ['s-days', 'Days'], ['s-rules', 'Rules'],
  ['s-waits', 'Never waits'], ['s-together', 'Together'], ['s-more', 'More'], ['s-local', 'Local'], ['s-close', 'Start'],
];
---
<nav class="snav" id="snav" aria-label="Sections">
  {SECTIONS.map(([id, label], i) => <a href={`#${id}`} data-for={id}><span>{String(i + 1).padStart(2, '0')} · {label}</span><i></i></a>)}
</nav>
<script>
  const nav = document.getElementById('snav');
  const links = [...nav.querySelectorAll('a')];
  const io = new IntersectionObserver(es => {
    for (const e of es) if (e.isIntersecting) links.forEach(a => a.classList.toggle('on', a.dataset.for === e.target.id));
  }, { rootMargin: '-48% 0px -48% 0px' });
  links.forEach(a => { const s = document.getElementById(a.dataset.for); if (s) io.observe(s); });
  const show = () => nav.classList.toggle('on', scrollY > innerHeight * 0.6);
  addEventListener('scroll', show, { passive: true }); show();
</script>
